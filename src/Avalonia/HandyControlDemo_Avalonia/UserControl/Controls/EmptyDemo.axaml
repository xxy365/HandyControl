<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:langs="using:HandyControlDemo.Properties.Langs"
             x:Class="HandyControlDemo.UserControl.EmptyDemo"
             Background="{DynamicResource RegionBrush}">
    <TransitioningContentControl>
        <StackPanel Margin="32">
            <hc:UniformSpacingPanel Spacing="32"
                                    ChildWrapping="Wrap"
                                    Orientation="Vertical">
                <hc:Empty Width="400"
                          HorizontalAlignment="Left"
                          Description="{Binding NoMessagesYet, Source={x:Static langs:LangProvider.Instance}}"
                          Padding="32" />
                <hc:Empty Width="400"
                          HorizontalAlignment="Left"
                          Description="{Binding NoData, Source={x:Static langs:LangProvider.Instance}}">
                    <Button Content="{Binding Retry, Source={x:Static langs:LangProvider.Instance}}"
                            Padding="14,6" />
                </hc:Empty>
            </hc:UniformSpacingPanel>
        </StackPanel>
    </TransitioningContentControl>
</UserControl>