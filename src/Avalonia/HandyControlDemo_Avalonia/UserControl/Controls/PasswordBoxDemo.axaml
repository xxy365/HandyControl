<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:langs="clr-namespace:HandyControlDemo.Properties.Langs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             x:Class="HandyControlDemo.UserControl.PasswordBoxDemo"
             Background="{DynamicResource RegionBrush}">
    <ScrollViewer>
        <hc:UniformSpacingPanel Spacing="32"
                                Margin="32"
                                ChildWrapping="Wrap">
            <StackPanel>
                <hc:PasswordBox Name="PasswordBoxUnsafe"
                                hc:InfoElement.ShowClearButton="True"
                                Password="123456"
                                IsSafeEnabled="False" />
                <TextBox Text="{Binding #PasswordBoxUnsafe.UnsafePassword}"
                         Margin="0,6,0,0" />
                <hc:PasswordBox Password="123456"
                                Margin="0,16,0,0" />

                <hc:PasswordBox hc:InfoElement.ShowClearButton="True"
                                hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                                Password="123456"
                                Margin="0,32,0,0" />
                <hc:PasswordBox ShowEyeButton="True"
                                hc:InfoElement.Placeholder="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                                hc:InfoElement.Necessary="True"
                                Margin="0,32,0,0" />

                <hc:PasswordBox hc:InfoElement.ShowClearButton="True"
                                Width="380"
                                hc:TitleElement.TitleWidth="140"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                Margin="0,32,0,0"
                                Password="123456" />
                <hc:PasswordBox hc:InfoElement.ShowClearButton="True"
                                ShowEyeButton="True"
                                Width="380"
                                hc:TitleElement.TitleWidth="140"
                                hc:InfoElement.Placeholder="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                hc:InfoElement.Necessary="True"
                                Margin="0,32,0,0" />
            </StackPanel>
            <StackPanel>
                <hc:PasswordBox Name="PasswordBoxUnsafeSmall"
                                hc:InfoElement.ShowClearButton="True"
                                Password="123456"
                                IsSafeEnabled="False"
                                Theme="{StaticResource PasswordBoxPlus.Small}" />
                <TextBox Text="{Binding #PasswordBoxUnsafeSmall.UnsafePassword}"
                         Margin="0,6,0,0" />
                <hc:PasswordBox Password="123456"
                                Margin="0,16,0,0"
                                Theme="{StaticResource PasswordBoxPlus.Small}" />

                <hc:PasswordBox hc:InfoElement.ShowClearButton="True"
                                hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                                Password="123456"
                                Margin="0,32,0,0"
                                Theme="{StaticResource PasswordBoxPlus.Small}" />
                <hc:PasswordBox ShowEyeButton="True"
                                hc:InfoElement.Placeholder="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                                hc:InfoElement.Necessary="True"
                                Margin="0,32,0,0"
                                Theme="{StaticResource PasswordBoxPlus.Small}" />

                <hc:PasswordBox hc:InfoElement.ShowClearButton="True"
                                Width="380"
                                hc:TitleElement.TitleWidth="140"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                Margin="0,32,0,0"
                                Password="123456"
                                Theme="{StaticResource PasswordBoxPlus.Small}" />
                <hc:PasswordBox hc:InfoElement.ShowClearButton="True"
                                ShowEyeButton="True"
                                Width="380"
                                hc:TitleElement.TitleWidth="140"
                                hc:InfoElement.Placeholder="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                hc:InfoElement.Necessary="True"
                                Margin="0,32,0,0"
                                Theme="{StaticResource PasswordBoxPlus.Small}" />
            </StackPanel>
        </hc:UniformSpacingPanel>
    </ScrollViewer>
</UserControl>
