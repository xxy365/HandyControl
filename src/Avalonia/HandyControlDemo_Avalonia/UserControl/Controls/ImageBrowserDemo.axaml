<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:langs="clr-namespace:HandyControlDemo.Properties.Langs"
             x:Class="HandyControlDemo.UserControl.ImageBrowserDemo"
             Background="{DynamicResource RegionBrush}">
    <TransitioningContentControl>
        <StackPanel Margin="32">
            <hc:ImageViewer x:Name="ImageViewerDemo" Background="{DynamicResource SecondaryRegionBrush}" MaxWidth="600" Height="330"/>
            <Button Margin="0,32,0,0"
                    Content="{Binding OpenImageBrowser, Source={x:Static langs:LangProvider.Instance}}"
                    Theme="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Center"
                    Click="OpenBrowser_OnClick"/>
        </StackPanel>
    </TransitioningContentControl>
</UserControl>