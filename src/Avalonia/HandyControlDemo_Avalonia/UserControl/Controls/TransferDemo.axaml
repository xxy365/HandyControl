<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:HandyControlDemo.ViewModel"
             xmlns:data="clr-namespace:HandyControlDemo.Data"
             x:Class="HandyControlDemo.UserControl.TransferDemo"
             x:DataType="vm:TransferViewModel"
             DataContext="{Binding Transfer, Source={x:Static vm:ViewModelLocator.Instance}}"
             Background="{DynamicResource RegionBrush}">
    <TransitioningContentControl>
        <ScrollViewer>
            <hc:UniformSpacingPanel ChildWrapping="Wrap"
                                    Margin="32"
                                    Spacing="32">
                <hc:Transfer ItemsSource="{Binding DataList}"
                             MinWidth="300"
                             Height="300">
                    <hc:Transfer.ItemTemplate>
                        <DataTemplate DataType="data:DemoDataModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </hc:Transfer.ItemTemplate>
                </hc:Transfer>
            </hc:UniformSpacingPanel>
        </ScrollViewer>
    </TransitioningContentControl>
</UserControl>