<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:HandyControlDemo.ViewModel"
             xmlns:cv="clr-namespace:HandyControlDemo.Tools.Converter"
             x:Class="HandyControlDemo.UserControl.CarouselDemo"
             x:DataType="vm:CarouselViewModel"
             DataContext="{Binding Carousel, Source={x:Static vm:ViewModelLocator.Instance}}"
             Background="{DynamicResource RegionBrush}">
    <UserControl.Resources>
        <cv:StringToBitmapConverter x:Key="StringToBitmap" />
    </UserControl.Resources>
    <TransitioningContentControl>
        <hc:Carousel Margin="32"
                     IsCenter="True"
                     AutoRun="True"
                     MaxWidth="600"
                     Height="330"
                     VerticalAlignment="Center"
                     ItemsSource="{Binding DataList}">
            <hc:Carousel.ItemTemplate>
                <DataTemplate DataType="x:String">
                    <Image Width="600"
                           Stretch="UniformToFill"
                           Source="{Binding Converter={StaticResource StringToBitmap}}" />
                </DataTemplate>
            </hc:Carousel.ItemTemplate>
        </hc:Carousel>
    </TransitioningContentControl>
</UserControl>