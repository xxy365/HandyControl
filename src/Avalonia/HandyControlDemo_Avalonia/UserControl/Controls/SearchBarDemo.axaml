<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:langs="using:HandyControlDemo.Properties.Langs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="using:HandyControlDemo.ViewModel"
             x:Class="HandyControlDemo.UserControl.SearchBarDemo"
             x:DataType="vm:InputElementDemoViewModel"
             DataContext="{ReflectionBinding InputElementDemo, Source={x:Static vm:ViewModelLocator.Instance}}"
             Background="{DynamicResource RegionBrush}">
    <TransitioningContentControl>
        <ScrollViewer>
            <hc:UniformSpacingPanel Spacing="32"
                                    Margin="32"
                                    ChildWrapping="Wrap">
                <StackPanel Spacing="16">
                    <hc:SearchBar SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar IsEnabled="False" />

                    <hc:SearchBar Theme="{StaticResource SearchBarExtend}"
                                  hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted"
                                  Margin="0,16,0,0" />
                    <hc:SearchBar Theme="{StaticResource SearchBarExtend}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarExtend}"
                                  Width="380"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarExtend}"
                                  Width="380"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus}"
                                  hc:InfoElement.ShowClearButton="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus}"
                                  IsEnabled="False" />

                    <hc:SearchBar Theme="{StaticResource SearchBarPlus}"
                                  hc:InfoElement.ShowClearButton="True"
                                  hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus}"
                                  PlaceholderText="{Binding PlsEnterEmail, Source={x:Static langs:LangProvider.Instance}}"
                                  Text="{Binding Email1, UpdateSourceTrigger=PropertyChanged}"
                                  hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus}"
                                  Width="380"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus}"
                                  Width="380"
                                  hc:InfoElement.ShowClearButton="True"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <hc:SearchBar Theme="{StaticResource SearchBar.Small}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBar.Small}"
                                  IsEnabled="False" />

                    <hc:SearchBar Theme="{StaticResource SearchBarExtend.Small}"
                                  hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarExtend.Small}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarExtend.Small}"
                                  Width="380"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarExtend.Small}"
                                  Width="380"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus.Small}"
                                  hc:InfoElement.ShowClearButton="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus.Small}"
                                  IsEnabled="False" />

                    <hc:SearchBar Theme="{StaticResource SearchBarPlus.Small}"
                                  hc:InfoElement.ShowClearButton="True"
                                  hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus.Small}"
                                  PlaceholderText="{Binding PlsEnterEmail, Source={x:Static langs:LangProvider.Instance}}"
                                  Text="{Binding Email2, UpdateSourceTrigger=PropertyChanged}"
                                  hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus.Small}"
                                  Width="380"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                    <hc:SearchBar Theme="{StaticResource SearchBarPlus.Small}"
                                  Width="380"
                                  hc:InfoElement.ShowClearButton="True"
                                  hc:TitleElement.TitleWidth="120"
                                  hc:TitleElement.TitlePlacement="Left"
                                  hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                                  PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                                  hc:InfoElement.Necessary="True"
                                  SearchStarted="SearchBar_OnSearchStarted" />
                </StackPanel>
            </hc:UniformSpacingPanel>
        </ScrollViewer>
    </TransitioningContentControl>
</UserControl>
