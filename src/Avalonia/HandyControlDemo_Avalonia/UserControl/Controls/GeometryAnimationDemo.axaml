<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HandyControlDemo.UserControl.GeometryAnimationDemo"
             Background="{DynamicResource RegionBrush}">
    <TransitioningContentControl>
        <Border Margin="32" Padding="40" CornerRadius="10" Background="{DynamicResource SecondaryRegionBrush}">
            <TextBlock Text="MorphingAnimation - Coming Soon" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </TransitioningContentControl>
</UserControl>