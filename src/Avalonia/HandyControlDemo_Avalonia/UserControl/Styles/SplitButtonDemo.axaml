<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:langs="clr-namespace:HandyControlDemo.Properties.Langs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             x:Class="HandyControlDemo.UserControl.SplitButtonDemo"
             Background="{DynamicResource RegionBrush}">
    <ScrollViewer>
        <hc:UniformSpacingPanel ChildWrapping="Wrap"
                                Spacing="32"
                                Margin="32">
            <hc:UniformSpacingPanel Orientation="Vertical"
                                    Spacing="32">
                <WrapPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Default, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item3, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Default, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Primary, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonPrimary}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item3, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Primary, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonPrimary}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Success, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonSuccess}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item3, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Success, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonSuccess}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Info, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonInfo}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item3, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Info, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonInfo}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Warning, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonWarning}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item3, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Warning, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonWarning}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Danger, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonDanger}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item3, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Danger, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonDanger}" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Calendar, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     hc:IconElement.Geometry="{StaticResource CalendarGeometry}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Today, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Tomorrow, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding NextWeek, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Calendar, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonPrimary}"
                                     hc:IconElement.Geometry="{StaticResource CalendarGeometry}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Today, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Tomorrow, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding NextWeek, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Default, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Primary, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonPrimary}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Success, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonSuccess}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Info, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonInfo}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Warning, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonWarning}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Danger, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonDanger}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                </WrapPanel>
            </hc:UniformSpacingPanel>

            <hc:UniformSpacingPanel Orientation="Vertical"
                                    Spacing="32">
                <WrapPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Default, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButton.Small}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Default, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButton.Small}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Primary, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonPrimary.Small}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Primary, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonPrimary.Small}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Success, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonSuccess.Small}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Success, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonSuccess.Small}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Info, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonInfo.Small}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Info, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonInfo.Small}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Warning, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonWarning.Small}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Warning, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonWarning.Small}" />
                    </StackPanel>
                    <StackPanel>
                        <SplitButton Content="{Binding Danger, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonDanger.Small}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding Item1, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding Item2, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <SplitButton IsEnabled="False"
                                     Content="{Binding Danger, Source={x:Static langs:LangProvider.Instance}}"
                                     Margin="5"
                                     Theme="{StaticResource SplitButtonDanger.Small}" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Default, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButton.Small}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Primary, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonPrimary.Small}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Success, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonSuccess.Small}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Info, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonInfo.Small}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Warning, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonWarning.Small}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                    <StackPanel>
                        <ToggleSplitButton Content="{Binding Danger, Source={x:Static langs:LangProvider.Instance}}"
                                           Margin="5"
                                           IsChecked="True"
                                           Theme="{StaticResource ToggleSplitButtonDanger.Small}">
                            <ToggleSplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding OptionA, Source={x:Static langs:LangProvider.Instance}}" />
                                    <MenuItem Header="{Binding OptionB, Source={x:Static langs:LangProvider.Instance}}" />
                                </MenuFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                </WrapPanel>
            </hc:UniformSpacingPanel>
        </hc:UniformSpacingPanel>
    </ScrollViewer>
</UserControl>
