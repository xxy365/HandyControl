<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:langs="using:HandyControlDemo.Properties.Langs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="using:HandyControlDemo.ViewModel"
             x:Class="HandyControlDemo.UserControl.TextBoxDemo"
             x:DataType="vm:InputElementDemoViewModel"
             DataContext="{ReflectionBinding InputElementDemo, Source={x:Static vm:ViewModelLocator.Instance}}">
    <ScrollViewer>
        <hc:UniformSpacingPanel Spacing="32"
                                Margin="32"
                                ChildWrapping="Wrap">
            <StackPanel>
                <TextBox Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}" />
                <TextBox Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}"
                         Margin="0,16,0,0"
                         IsEnabled="False" />

                <TextBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend}"
                         Margin="0,32,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}" />
                <TextBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                         hc:InfoElement.ShowClearButton="True"
                         Theme="{StaticResource TextBoxExtend}"
                         Margin="0,32,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}" />
                <TextBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend}"
                         Margin="0,16,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}"
                         IsEnabled="False" />
                <TextBox PlaceholderText="{Binding PlsEnterEmail, Source={x:Static langs:LangProvider.Instance}}"
                         Text="{Binding Email1, UpdateSourceTrigger=PropertyChanged}"
                         hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Necessary="True"
                         Margin="0,16,0,0" />
                <TextBox Width="380"
                         hc:TitleElement.TitleWidth="120"
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend}"
                         Margin="0,32,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}" />
                <TextBox Width="380"
                         Text="{Binding Text1, UpdateSourceTrigger=PropertyChanged}"
                         hc:TitleElement.TitleWidth="120"
                         PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                         hc:InfoElement.Necessary="True"
                         Theme="{StaticResource TextBoxExtend}"
                         Margin="0,16,0,0" />
            </StackPanel>
            <StackPanel>
                <TextBox Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}"
                         PasswordChar="●"
                         Theme="{StaticResource TextBox.Small}" />
                <TextBox Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}"
                         Margin="0,16,0,0"
                         IsEnabled="False"
                         Theme="{StaticResource TextBox.Small}" />

                <TextBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend.Small}"
                         Margin="0,32,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}" />
                <TextBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                         hc:InfoElement.ShowClearButton="True"
                         Theme="{StaticResource TextBoxExtend.Small}"
                         Margin="0,32,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}" />
                <TextBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend.Small}"
                         Margin="0,16,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}"
                         IsEnabled="False" />
                <TextBox PlaceholderText="{Binding PlsEnterEmail, Source={x:Static langs:LangProvider.Instance}}"
                         Text="{Binding Email2, UpdateSourceTrigger=PropertyChanged}"
                         hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend.Small}"
                         hc:InfoElement.Necessary="True"
                         Margin="0,16,0,0" />
                <TextBox Width="380"
                         hc:TitleElement.TitleWidth="120"
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                         Theme="{StaticResource TextBoxExtend.Small}"
                         Margin="0,32,0,0"
                         Text="{Binding ThisIsTheContent, Source={x:Static langs:LangProvider.Instance}}" />
                <TextBox Width="380"
                         Text="{Binding Text2, UpdateSourceTrigger=PropertyChanged}"
                         hc:TitleElement.TitleWidth="120"
                         PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                         hc:TitleElement.TitlePlacement="Left"
                         hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                         hc:InfoElement.Necessary="True"
                         Theme="{StaticResource TextBoxExtend.Small}"
                         Margin="0,16,0,0" />
            </StackPanel>
        </hc:UniformSpacingPanel>
    </ScrollViewer>
</UserControl>
