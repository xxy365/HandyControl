<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:langs="using:HandyControlDemo.Properties.Langs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="using:HandyControlDemo.ViewModel"
             x:Class="HandyControlDemo.UserControl.ComboBoxDemo"
             x:DataType="vm:InputElementDemoViewModel"
             DataContext="{ReflectionBinding InputElementDemo, Source={x:Static vm:ViewModelLocator.Instance}}">
    <ScrollViewer>
        <hc:UniformSpacingPanel Spacing="32"
                                Margin="32"
                                ChildWrapping="Wrap">
            <StackPanel>
                <ComboBox ItemsSource="{Binding DataList}" />
                <ComboBox ItemsSource="{Binding DataList}"
                          Margin="0,16,0,0"
                          IsEnabled="False" />

                <ComboBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend}"
                          Margin="0,32,0,0"
                          ItemsSource="{Binding DataList}" />
                <ComboBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                          hc:InfoElement.ShowClearButton="True"
                          Theme="{StaticResource ComboBoxExtend}"
                          Margin="0,32,0,0"
                          ItemsSource="{Binding DataList}" />
                <ComboBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend}"
                          Margin="0,16,0,0"
                          ItemsSource="{Binding DataList}"
                          IsEnabled="False" />
                <ComboBox PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                          ItemsSource="{Binding DataList}"
                          hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend}"
                          hc:InfoElement.Necessary="True"
                          Margin="0,16,0,0" />
                <ComboBox Width="380"
                          hc:TitleElement.TitleWidth="120"
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend}"
                          Margin="0,32,0,0"
                          ItemsSource="{Binding DataList}" />
                <ComboBox Width="380"
                          ItemsSource="{Binding DataList}"
                          hc:TitleElement.TitleWidth="120"
                          PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                          hc:InfoElement.Necessary="True"
                          Theme="{StaticResource ComboBoxExtend}"
                          Margin="0,16,0,0" />
            </StackPanel>
            <StackPanel>
                <ComboBox ItemsSource="{Binding DataList}"
                          Theme="{StaticResource ComboBox.Small}" />
                <ComboBox ItemsSource="{Binding DataList}"
                          Margin="0,16,0,0"
                          IsEnabled="False"
                          Theme="{StaticResource ComboBox.Small}" />

                <ComboBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend.Small}"
                          Margin="0,32,0,0"
                          ItemsSource="{Binding DataList}" />
                <ComboBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                          hc:InfoElement.ShowClearButton="True"
                          Theme="{StaticResource ComboBoxExtend.Small}"
                          Margin="0,32,0,0"
                          ItemsSource="{Binding DataList}" />
                <ComboBox hc:TitleElement.Title="{Binding TitleDemoStr1, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend.Small}"
                          Margin="0,16,0,0"
                          ItemsSource="{Binding DataList}"
                          IsEnabled="False" />
                <ComboBox PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                          ItemsSource="{Binding DataList}"
                          hc:TitleElement.Title="{Binding TitleDemoStr2, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend.Small}"
                          hc:InfoElement.Necessary="True"
                          Margin="0,16,0,0" />
                <ComboBox Width="380"
                          hc:TitleElement.TitleWidth="120"
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                          Theme="{StaticResource ComboBoxExtend.Small}"
                          Margin="0,32,0,0"
                          ItemsSource="{Binding DataList}" />
                <ComboBox Width="380"
                          ItemsSource="{Binding DataList}"
                          hc:TitleElement.TitleWidth="120"
                          PlaceholderText="{Binding PlsEnterContent, Source={x:Static langs:LangProvider.Instance}}"
                          hc:TitleElement.TitlePlacement="Left"
                          hc:TitleElement.Title="{Binding TitleDemoStr3, Source={x:Static langs:LangProvider.Instance}}"
                          hc:InfoElement.Necessary="True"
                          Theme="{StaticResource ComboBoxExtend.Small}"
                          Margin="0,16,0,0" />
            </StackPanel>
        </hc:UniformSpacingPanel>
    </ScrollViewer>
</UserControl>
