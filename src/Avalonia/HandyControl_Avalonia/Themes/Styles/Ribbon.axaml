<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal"
                    xmlns:hc="clr-namespace:HandyControl.Controls">

    <Geometry x:Key="NailGeometry">M956.553 366.486L657.514 67.447c-7.888-7.888-18.204-11.772-28.52-11.772s-20.632 3.884-28.52 11.772L404.958 263.085c-14.806-1.7-29.734-2.428-44.662-2.428-88.837 0-177.675 29.249-250.614 87.746-18.69 14.927-20.268 42.962-3.277 59.953l220.516 220.517L65.506 890.046c-3.156 3.155-5.219 7.403-5.583 11.893l-4.126 45.147c-1.093 11.408 8.01 21.117 19.296 21.117 0.607 0 1.214 0 1.82-0.121l45.148-4.126c4.49-0.364 8.738-2.428 11.893-5.583L395.37 696.957l220.517 220.517c7.888 7.888 18.204 11.772 28.52 11.772 11.772 0 23.423-5.097 31.433-15.05 68.327-85.317 96.726-192.117 85.197-295.397l195.516-195.515c15.655-15.535 15.655-41.021 0-56.798zM699.142 557.268l-29.734 29.734 4.612 41.75c4.49 40.898 1.213 81.555-9.952 120.998-6.554 23.059-15.535 45.026-26.943 65.779L208.593 386.753c15.655-8.616 31.918-15.898 48.909-21.724 33.01-11.408 67.599-17.112 102.794-17.112 11.651 0 23.423 0.607 35.074 1.942l41.75 4.612 29.733-29.734 162.262-162.262 232.41 232.41-162.383 162.383z</Geometry>
    <Geometry x:Key="DialogBoxLauncherGeometry">M0,0 8,0 8,1 1,1 1,8 0,8 M 3.7,3 8,7.3 8,4 9,4 9,9 4,9 4,8 7.3,8 3,3.7</Geometry>

    <ControlTheme x:Key="RibbonGroupBaseStyle"
                  TargetType="hc:RibbonGroup">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="Height"
                Value="90" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding"
                Value="6,6,6,0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="hc:RibbonGroup">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsPresenter Grid.ColumnSpan="2"
                                    Margin="{TemplateBinding Padding}" />
                    <ContentPresenter Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="10,0,10,2"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    <Button x:Name="PART_LauncherButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="16"
                            Height="16"
                            Margin="0,0,2,0"
                            HorizontalAlignment="Right"
                            IsVisible="{TemplateBinding ShowLauncherButton}"
                            Theme="{StaticResource ButtonCustom}"
                            hc:BackgroundSwitchElement.MouseHoverBackground="{DynamicResource SecondaryRegionBrush}"
                            hc:AdornerElement.Instance="{TemplateBinding LauncherPoptip}">
                        <Path Width="9"
                              Height="9"
                              Stretch="Uniform"
                              Data="{StaticResource DialogBoxLauncherGeometry}"
                              Fill="{DynamicResource SecondaryTextBrush}" />
                    </Button>
                    <Border Grid.RowSpan="2"
                            Grid.Column="2"
                            Width="1"
                            Margin="0,4"
                            Background="{TemplateBinding BorderBrush}"
                            IsVisible="{TemplateBinding ShowSplitter}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type hc:RibbonGroup}"
                  TargetType="hc:RibbonGroup"
                  BasedOn="{StaticResource RibbonGroupBaseStyle}" />

    <ControlTheme x:Key="RibbonTabHeaderBaseStyle"
                  TargetType="hc:RibbonTabHeader">
        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource TitleBrush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Padding"
                Value="{StaticResource DefaultControlPadding}" />
        <Setter Property="MinHeight"
                Value="{StaticResource DefaultControlHeight}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="hc:RibbonTabHeader">
                <Border Background="{TemplateBinding Background}">
                    <hc:SimplePanel>
                        <Border IsVisible="{TemplateBinding IsSelected}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,2"
                                Margin="12,0,12,2" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </hc:SimplePanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="hc|RibbonTabHeader[IsSelected=True]">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type hc:RibbonTabHeader}"
                  TargetType="hc:RibbonTabHeader"
                  BasedOn="{StaticResource RibbonTabHeaderBaseStyle}" />

    <ControlTheme x:Key="RibbonTabBaseStyle"
                  TargetType="hc:RibbonTab">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="hc:RibbonTab">
                <hc:SimplePanel x:Name="PART_RootContainer"
                                IsVisible="False">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,3"
                            Background="{TemplateBinding Background}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsPresenter x:Name="PART_ItemsPresenter" />
                    </ScrollViewer>
                </hc:SimplePanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type hc:RibbonTab}"
                  TargetType="hc:RibbonTab"
                  BasedOn="{StaticResource RibbonTabBaseStyle}" />

    <ControlTheme x:Key="RibbonBaseStyle"
                  TargetType="hc:Ribbon">
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="ZIndex"
                Value="2147483647" />
        <Setter Property="ContentHeight"
                Value="96" />
        <Setter Property="Background"
                Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
        <Setter Property="hc:BorderElement.CornerRadius"
                Value="{StaticResource DefaultCornerRadius}" />
        <Setter Property="Padding"
                Value="10,0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <hc:SimplePanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="hc:Ribbon">
                <hc:ClipGrid x:Name="PART_RootPanel"
                             IsClipEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PART_ContentPanel"
                          Grid.Row="1"
                          Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2"
                                Height="{TemplateBinding ContentHeight}"
                                VerticalAlignment="Bottom"
                                Margin="{TemplateBinding Padding}"
                                CornerRadius="{Binding (hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{DynamicResource RegionBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  OffsetY="2"
                                                  Color="{StaticResource EffectShadowColor}"
                                                  Opacity="0.1" />
                            </Border.Effect>
                        </Border>
                        <ItemsPresenter x:Name="PART_ItemsPresenter"
                                        Grid.Column="0"
                                        Height="{TemplateBinding ContentHeight}"
                                        VerticalAlignment="Bottom"
                                        Margin="10,0,0,0" />
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{TemplateBinding IsMinimized, Mode=TwoWay}"
                                      Padding="2,0"
                                      Width="16"
                                      Height="20"
                                      Margin="0,0,10,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Theme="{StaticResource ToggleButtonIconTransparent}"
                                      hc:IconSwitchElement.Geometry="{StaticResource UpGeometry}"
                                      hc:IconSwitchElement.GeometrySelected="{StaticResource NailGeometry}" />
                    </Grid>
                    <ContentPresenter Grid.Row="0"
                                      Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding PrefixContent}" />
                    <hc:RibbonTabHeaderItemsControl x:Name="PART_TabHeaderItemsControl"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Background="{TemplateBinding Background}"
                                                    Focusable="False"
                                                    Margin="0,0,0,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=hc:Ribbon}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </hc:RibbonTabHeaderItemsControl>
                    <ContentPresenter Grid.Row="0"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding PostfixContent}" />
                </hc:ClipGrid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type hc:Ribbon}"
                  TargetType="hc:Ribbon"
                  BasedOn="{StaticResource RibbonBaseStyle}" />

</ResourceDictionary>
