<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal"
                    xmlns:hc="clr-namespace:HandyControl.Controls">

    <ControlTheme x:Key="GrowlBaseStyle"
                  TargetType="hc:Growl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Width" Value="320" />
        <Setter Property="Margin" Value="10,10,10,0" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ThirdlyRegionBrush}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="hc:Growl">
                <Grid x:Name="PART_GridMain" RenderTransformOrigin="0.5,0.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.ColumnSpan="3"
                            Grid.RowSpan="2"
                            Effect="{DynamicResource EffectShadow2}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{Binding (hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                    <Path Grid.Row="0"
                          Grid.Column="0"
                          VerticalAlignment="Top"
                          Margin="0,15,0,0"
                          Width="30"
                          Height="30"
                          Data="{TemplateBinding Icon}"
                          Stretch="Uniform"
                          Fill="{TemplateBinding IconBrush}" />
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="0,10,10,10">
                        <TextBlock Text="{TemplateBinding Message}"
                                   Theme="{DynamicResource TextBlockDefault}"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap" />
                        <TextBlock IsVisible="{TemplateBinding ShowDateTime}"
                                   Text="{TemplateBinding Time}"
                                   Theme="{DynamicResource TextBlockDefault}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Left"
                                   Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="yyyy/MM/dd HH:mm:ss">
                                    <Binding Path="Time" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Row="0"
                            IsVisible="False"
                            Margin="11,0"
                            x:Name="PART_ButtonClose"
                            Grid.Column="2"
                            Background="Transparent"
                            Theme="{DynamicResource ButtonCustom}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="18"
                            Height="18">
                        <Path Data="{DynamicResource ErrorGeometry}"
                              Stretch="Uniform"
                              Fill="{DynamicResource SecondaryTextBrush}" />
                    </Button>
                    <UniformGrid Grid.Row="1"
                                 Columns="2"
                                 x:Name="PART_PanelMore"
                                 IsEnabled="False"
                                 IsVisible="False"
                                 Grid.ColumnSpan="3"
                                 Height="28"
                                 Grid.Column="0">
                        <Button x:Name="PART_ButtonCancel"
                                Theme="{DynamicResource ButtonCustom}"
                                HorizontalAlignment="Stretch"
                                Background="Transparent">
                            <TextBlock Text="{TemplateBinding CancelStr}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                        <Button x:Name="PART_ButtonConfirm"
                                Theme="{DynamicResource ButtonCustom}"
                                HorizontalAlignment="Stretch"
                                Background="Transparent">
                            <TextBlock Text="{TemplateBinding ConfirmStr}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </Button>
                    </UniformGrid>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[(hc|Growl.TransitionMode)=Bottom2Top]">
            <Setter Property="Margin" Value="10,0,10,10" />
        </Style>
        <Style Selector="^[(hc|Growl.TransitionMode)=Bottom2TopWithFade]">
            <Setter Property="Margin" Value="10,0,10,10" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type hc:Growl}"
                  TargetType="hc:Growl"
                  BasedOn="{StaticResource GrowlBaseStyle}" />

</ResourceDictionary>
