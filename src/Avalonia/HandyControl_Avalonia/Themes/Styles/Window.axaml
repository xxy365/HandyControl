<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="using:HandyControl.Controls" x:ClassModifier="internal">

    <!--
      HandyControl.Window 只负责窗口内容区与背景，不再自绘标题栏和
      最小化/最大化/关闭按钮 —— 这些交给系统标题栏（WindowDecorations）。

      原因（Avalonia 12.1.3 实测）：
      1) 自绘标题栏要么走 WindowDrawnDecorations（官方装饰层），要么退回
         ExtendClientAreaToDecorationsHint + ElementRole 伪装，两条路都导致
         标题栏内的 Menu / Button 收不到点击。
      2) 四个 CaptionButton 即便用官方装饰层画出来，也不走 Avalonia 输入系统
         （:pointerover 不触发，点击靠 Win32 非客户区消息），
         等于用一层不可测的模拟实现换掉了系统行为。
      3) WindowDrawnDecorations 的 Overlay 是 TopLevelHost 的独立合成层，
         该层零指针输入；Full（CSD 激活）时它会盖住客户端区顶部条带，
         BorderOnly 时它的标题栏与窗口按钮高度塌为 0。两者都拿不到可交互标题栏。

      仍保留的对外属性（CustomTitleBarContent / CustomTitleBarHeight /
      ShowTitle 等）仅为不破坏既有调用方，主题不再消费它们。
    -->
    <ControlTheme x:Key="{x:Type hc:Window}"
                  TargetType="hc:Window">
        <Setter Property="Background"
                Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Template">
            <ControlTemplate TargetType="hc:Window">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      ClipToBounds="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>